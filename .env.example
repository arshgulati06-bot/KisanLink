# Copy to `.env` locally. Do not commit real keys.

# Official data.gov.in / AGMARKNET daily mandi prices
# Register at https://data.gov.in/ and attach an API key to the AGMARKNET
# resource you intend to use. Do not invent a resource id.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
# DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# OpenRouteService (preferred production routing). Without this key the
# server may try the public OSRM demo, then fall back to labelled Haversine.
ROUTING_API_KEY=
# ORS_API_KEY=
# OSRM_BASE_URL=https://router.project-osrm.org

# Freight is a two-part planning estimate, not an official tariff:
#   cost per quintal = TRANSPORT_LOADING_PER_QTL + TRANSPORT_RATE_PER_QTL_KM x km
# Defaults (25 + 1.2/km) put a 150 km trip at about Rs 205/QTL.
# TRANSPORT_LOADING_PER_QTL=25
# TRANSPORT_RATE_PER_QTL_KM=1.2

# NOMINATIM_USER_AGENT=KisanLink/1.0 (agricultural decision support)
# KISANLINK_DISABLE_EXTERNAL=1

# Run the app without the large ml/data/*.csv files, using generated sample
# rows. Every response is then labelled dev_fixture=true and the dashboard
# shows a "not real mandi prices" banner. Never enable this for real use.
# KISANLINK_DEV_FIXTURE=1
