# Copy to `.env` locally. Do not commit real keys.

# Official data.gov.in / AGMARKNET daily mandi prices
# Register at https://data.gov.in/ and attach an API key to the AGMARKNET
# resource you intend to use. Do not invent a resource id.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
# DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# OpenRouteService (preferred production routing). Without this key the
# server may try the public OSRM demo, then fall back to labelled Haversine.
ROUTING_API_KEY=
# ORS_API_KEY=
# OSRM_BASE_URL=https://router.project-osrm.org

# Planning rate only — not an official freight tariff
# TRANSPORT_RATE_PER_QTL_KM=8

# NOMINATIM_USER_AGENT=KisanLink/1.0 (agricultural decision support)
# KISANLINK_DISABLE_EXTERNAL=1
