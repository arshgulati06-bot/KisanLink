# ---------------------------------------------------------------------------
# KisanLink backend configuration
# Copy to backend/.env (or the repository root) and edit.
# ---------------------------------------------------------------------------

FLASK_APP=run.py
FLASK_ENV=development
PORT=5000

# Sign a real 32+ character random string here before deploying anywhere
# other people can reach. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRY_HOURS=24

# ---- Database -------------------------------------------------------------
# "mysql" is the deployment target. Set "sqlite" to run without a MySQL
# server (the test suite always uses sqlite).
DB_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=2467
DB_NAME=kisanlink_db

# When MySQL is unreachable at startup, fall back to SQLite instead of
# refusing to start. Handy while developing; set false in production so a
# misconfigured database fails loudly.
DB_ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=kisanlink.sqlite3

# ---- CORS -----------------------------------------------------------------
# The frontend origin. "*" is fine for local development only.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Intelligence tuning. Every number the recommendation engine uses lives
# here or in app/config/settings.py, so nothing is buried in the code.
# ---------------------------------------------------------------------------

# Matching weights. Must sum to 1.0. Starting values from the project
# documentation - tune them, do not treat them as learned.
WEIGHT_PRICE=0.35
WEIGHT_QUANTITY=0.20
WEIGHT_QUALITY=0.20
WEIGHT_DISTANCE=0.15
WEIGHT_TRUST=0.10

# Distance beyond which a buyer scores zero on the distance component.
MAX_MATCH_DISTANCE_KM=300
# Straight-line distance is scaled by this to approximate road distance.
ROAD_DISTANCE_FACTOR=1.3

# Transport cost model (planning estimates, not quotations).
TRANSPORT_BASE_FARE=300
TRANSPORT_RATE_PER_KM_PER_TONNE=6
TRANSPORT_MIN_CHARGE=500
LOADING_COST_PER_TONNE=150

# Mandi deductions the headline modal price does not show.
MANDI_COMMISSION_PERCENT=2.0
MANDI_MARKET_FEE_PERCENT=1.0

# Storage cost model.
DEFAULT_STORAGE_COST_PER_TONNE_PER_DAY=12
STORAGE_LOSS_PERCENT_PER_DAY=0.3

# Forecasting. Below MIN_FORECAST_HISTORY_POINTS observations the API
# returns "insufficient historical data" instead of a number.
MIN_FORECAST_HISTORY_POINTS=10
FORECAST_DEFAULT_HORIZON_DAYS=7
FORECAST_MAX_HORIZON_DAYS=30
SALE_WINDOW_GAIN_MARGIN_PERCENT=2.0
