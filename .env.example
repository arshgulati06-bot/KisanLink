# Copy to `.env` locally. Do not commit real keys.

# ---------------------------------------------------------------------------
# LIVE MANDI PRICES (official data.gov.in / AGMARKNET)
# ---------------------------------------------------------------------------
# The adapter in backend/services/mandi_live.py is complete and tested; it only
# needs these two values. Until both are set, /api/market-prices/live reports
# "Live mandi feed unavailable" and the UI falls back to the local dataset,
# clearly labelled — it never shows a LIVE badge on non-live data.
#
# HOW TO GET THEM
#   1. Register at https://data.gov.in/ and copy your personal API key
#      from https://data.gov.in/my-account  ->  DATA_GOV_API_KEY
#   2. Open the resource page for "Current Daily Price of Various Commodities
#      from Various Markets (Mandi)" and copy the resource UUID out of its URL
#      (…/resource/<UUID>)                  ->  DATA_GOV_RESOURCE_ID
#
# WHERE TO PUT THEM: copy this file to `.env` in the project root (it is
# gitignored) and fill both values in, then restart `python backend/app.py`.
# The request built is:
#   GET {DATA_GOV_BASE_URL}/{DATA_GOV_RESOURCE_ID}
#       ?api-key=...&format=json&limit=...&offset=0
#       [&filters[commodity]=..&filters[state]=..&filters[district]=..&filters[market]=..]
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
# DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# OpenRouteService (preferred production routing). Without this key the
# server may try the public OSRM demo, then fall back to labelled Haversine.
ROUTING_API_KEY=
# ORS_API_KEY=
# OSRM_BASE_URL=https://router.project-osrm.org

# Freight is a two-part planning estimate, not an official tariff:
#   cost per quintal = TRANSPORT_LOADING_PER_QTL + TRANSPORT_RATE_PER_QTL_KM x km
# Defaults (25 + 1.2/km) put a 150 km trip at about Rs 205/QTL.
# TRANSPORT_LOADING_PER_QTL=25
# TRANSPORT_RATE_PER_QTL_KM=1.2

# NOMINATIM_USER_AGENT=KisanLink/1.0 (agricultural decision support)
# KISANLINK_DISABLE_EXTERNAL=1

# Run the app without the large ml/data/*.csv files, using generated sample
# rows. Every response is then labelled dev_fixture=true and the dashboard
# shows a "not real mandi prices" banner. Never enable this for real use.
# KISANLINK_DEV_FIXTURE=1
