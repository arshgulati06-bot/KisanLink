# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──
.venv/
venv/
ENV/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
Thumbs.db
.DS_Store
desktop.ini

# ── HuggingFace / Model Cache ──
.cache/

# ── ML Outputs (generated at runtime) ──
ml/outputs/*.png

# ── ML Dataset (large archives) ──
# The CSV archives (Agriculture_price_dataset.csv, 2022.csv, 2026.csv) are
# 50 MB+ each and stay out of git — download them separately into ml/data/.
# The 2023/2024/2025 .xlsx workbooks ARE committed and are deliberately not
# ignored here, so a fresh clone has real mandi history to forecast from.
ml/data/*.csv
ml/data/_cache/
ml/data/ingested/ingest.log
ml/data/ingested/records.csv
*.bak

# ── Node (if any) ──
node_modules/

# ── Byte-compiled ──
*.pyc

# Local secrets — never commit
.env
.env.local
.env.*.local
backend/*.sqlite3
backend/*.sqlite3-shm
backend/*.sqlite3-wal

# Uploaded sale-lot photos (runtime data, not source)
backend/uploads/

# NOTE: the four quality-model checkpoints in ml/quality_models/ ARE committed
# (~17 MB each) so a fresh clone can run photo analysis with no extra download.
# They are deliberately not ignored here.
